# Database Seeder Dockerfile
FROM node:22-alpine

WORKDIR /app

# Install only production dependencies for seeding
COPY package*.json ./
RUN npm ci --only=production

# Copy seeding scripts and data
COPY scripts/ ./scripts/
COPY data/ ./data/
COPY server/config/ ./server/config/

# Run seeding command
CMD ["node", "scripts/seed-database.js"]
