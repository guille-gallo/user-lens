# Staging Environment (Production Mirror)
# This file will be used in GitHub Actions and staging deployments

# Application
NODE_ENV=staging
PORT=3001

# Database Configuration - Staging Redis Cluster
REDIS_URL=${REDIS_STAGING_URL}
REDIS_HOST=${REDIS_STAGING_HOST}
REDIS_PORT=6379
REDIS_DB=0

# Fallback Database
FALLBACK_DB_PATH=./db.json

# Data Seeding
DB_SEED_SIZE=10000
DB_SEED_TYPE=synthetic_plus_anonymized

# API Configuration
API_BASE_URL=${VERCEL_STAGING_URL}
VITE_API_URL=${VERCEL_STAGING_URL}

# Production-like Features
ENABLE_DEBUG_LOGS=false
ENABLE_HOT_RELOAD=false
ENABLE_MOCK_DELAY=true

# Security
CORS_ORIGIN=${VERCEL_STAGING_URL}
JWT_SECRET=${JWT_SECRET_STAGING}

# Database Connection Pool
REDIS_MAX_CONNECTIONS=20
REDIS_MIN_CONNECTIONS=5

# Cache Configuration
CACHE_TTL=1800
ENABLE_REDIS_CACHE=true

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# Health Checks
HEALTH_CHECK_INTERVAL=30000
REDIS_HEALTH_CHECK=true
