# Production Environment
# This file template is used for Vercel production deployment

# Application
NODE_ENV=production
PORT=3001

# Database Configuration - Production Redis Cluster
REDIS_URL=${REDIS_PRODUCTION_URL}
REDIS_HOST=${REDIS_PRODUCTION_HOST}
REDIS_PORT=6379
REDIS_DB=0

# Fallback Database (minimal fallback)
FALLBACK_DB_PATH=./db-production.json

# Data Seeding (production doesn't seed, just migrations)
DB_SEED_SIZE=0
DB_SEED_TYPE=none

# API Configuration
API_BASE_URL=${VERCEL_URL}
VITE_API_URL=${VERCEL_URL}

# Production Features
ENABLE_DEBUG_LOGS=false
ENABLE_HOT_RELOAD=false
ENABLE_MOCK_DELAY=false

# Security
CORS_ORIGIN=${VERCEL_URL}
JWT_SECRET=${JWT_SECRET_PRODUCTION}

# Database Connection Pool (optimized for production)
REDIS_MAX_CONNECTIONS=50
REDIS_MIN_CONNECTIONS=10

# Cache Configuration
CACHE_TTL=3600
ENABLE_REDIS_CACHE=true

# Monitoring & Logging
LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=false
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true

# Health Checks
HEALTH_CHECK_INTERVAL=60000
REDIS_HEALTH_CHECK=true

# Performance
ENABLE_COMPRESSION=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Backup Configuration
ENABLE_AUTOMATED_BACKUP=true
BACKUP_INTERVAL=86400000
